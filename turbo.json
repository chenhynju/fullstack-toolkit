{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "RATE_LIMIT_NAMESPACE",
    "APP_ORIGIN",
    "API_INTERNAL_URL",
    "PORT",
    "HOST",
    "TRUST_PROXY",
    "BUILD_STANDALONE"
  ],
  "globalDependencies": [
    ".env",
    ".env.example",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "scripts/run.mjs",
    "packages/config-eslint/**",
    "packages/config-typescript/**",
    "packages/config-tailwind/**"
  ],
  "globalPassThroughEnv": [
    "TEST_ADMIN_DATABASE_URL",
    "TEST_APP_PASSWORD",
    "MIGRATION_DATABASE_URL",
    "E2E_BASE_URL",
    "E2E_ADMIN_EMAIL",
    "E2E_ADMIN_PASSWORD",
    "CI",
    "E2E_RUN_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "e2e": {
      "dependsOn": ["build", "@repo/api#build"],
      "cache": false
    },
    "analyze": {
      "cache": false
    }
  }
}
