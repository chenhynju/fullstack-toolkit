# 参考实现：以正确性优先（单阶段 + 全量依赖）。
# 体积/构建提速优化（多阶段、pnpm deploy、层缓存）见 docs/adr/0002 与 docs/perf-report-template.md
FROM node:22-alpine
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps apps
COPY packages packages

RUN pnpm install --frozen-lockfile --filter @repo/api...
RUN pnpm --filter @repo/db build && pnpm --filter @repo/api build

ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "apps/api/dist/server.js"]
