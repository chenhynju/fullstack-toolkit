{
  "name": "fullstack-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo 工程模板：Next.js + Fastify + Turborepo + pnpm，内置质量门禁、性能预算与 CI/CD",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "analyze": "turbo run analyze",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size-check": "node scripts/check-budget.mjs",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "postinstall": "pnpm --filter @repo/db build"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
