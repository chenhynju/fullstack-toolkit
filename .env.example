NODE_ENV=development
# Local examples only; production uses random private credentials.
DATABASE_URL=postgresql://toolkit_app:local-dev-only@127.0.0.1:5432/toolkit
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
# Use the owner URL only for migrations/import, never for the API:
# MIGRATION_DATABASE_URL=postgresql://postgres:local-migration-only@127.0.0.1:5432/toolkit
# Isolated integration tests require their own PostgreSQL/Redis environment:
# TEST_ADMIN_DATABASE_URL=postgresql://postgres:local-migration-only@127.0.0.1:5432/toolkit
# TEST_APP_PASSWORD=local-dev-only
# RATE_LIMIT_NAMESPACE=toolkit-saas-development
